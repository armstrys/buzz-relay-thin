[Unit]
Description=buzz relay
Documentation=https://github.com/block/buzz
# The relay needs Postgres, Redis, and MinIO, which run as containers.
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__

# WorkingDirectory is the repo checkout so relative paths and .env resolve.
WorkingDirectory=__INSTALL_DIR__/src
EnvironmentFile=__INSTALL_DIR__/src/.env
# Apply migrations on every start via the compiled buzz-admin binary. This
# deliberately does NOT use `just migrate`: `just` comes from Hermit, which
# needs a writable ~/.cache and a login PATH, neither of which exist under this
# unit's hardening (ProtectHome/ProtectSystem make /root read-only). The binary
# needs neither. Migrations are idempotent; the relay itself ensures the
# community host row at startup ("Deployment community ensured"), so no seed
# step is required here. Remove this line to migrate only by hand.
ExecStartPre=__INSTALL_DIR__/src/target/release/buzz-admin migrate
ExecStart=__INSTALL_DIR__/src/target/release/buzz-relay

Restart=on-failure
RestartSec=5s
# Give the datastores time to come up after a host reboot before giving up.
StartLimitBurst=10
StartLimitIntervalSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=buzz-relay

# ---- hardening -------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__INSTALL_DIR__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target

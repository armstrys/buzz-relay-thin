# buzz-relay environment.
#
# This file is BOTH:
#   - the variable source for docker compose (which interpolates ${VAR} here), and
#   - the EnvironmentFile for the systemd unit.
#
# systemd does NOT expand ${VAR} inside an EnvironmentFile, so every value below
# must be literal. That is why the Postgres password appears in two places
# (POSTGRES_PASSWORD for compose, and inline in DATABASE_URL for the relay).
# install.sh renders both from one generated secret so they cannot drift. If you
# rotate by hand, change both.
#
# Generated secrets are hex (openssl rand -hex), deliberately alphanumeric so
# they need no URL-encoding in DATABASE_URL and no escaping in compose.

# ---- canonical relay identity ---------------------------------------------
# RELAY_URL is the authority every client must use. The relay fails closed on a
# Host header that has no row in the `communities` table, and that table holds
# one row per host, so each authority is a SEPARATE community. Pick one name and
# use it on every device. Prefer a stable DNS name over a DHCP address.
RELAY_URL=ws://__RELAY_HOST__:__RELAY_PORT__

# Listen on all interfaces. The relay is the only service exposed off-box.
BUZZ_BIND_ADDR=0.0.0.0:__RELAY_PORT__

# ---- Postgres --------------------------------------------------------------
POSTGRES_USER=buzz
POSTGRES_PASSWORD=__PG_PASSWORD__
POSTGRES_DB=buzz
POSTGRES_PORT=5432

DATABASE_URL=postgres://buzz:__PG_PASSWORD__@localhost:5432/buzz

# Consumed by scripts/seed-local-community.sh
PGHOST=localhost
PGPORT=5432
PGUSER=buzz
PGPASSWORD=__PG_PASSWORD__
PGDATABASE=buzz

# ---- Redis -----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- Object storage --------------------------------------------------------
# These default to buzz_dev / buzz_dev_secret in code, so they MUST be set
# explicitly or you silently keep dev credentials.
BUZZ_S3_ENDPOINT=http://localhost:9000
BUZZ_S3_ACCESS_KEY=buzzrelay
BUZZ_S3_SECRET_KEY=__S3_SECRET__
BUZZ_S3_BUCKET=buzz-media
BUZZ_S3_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- relay identity and auth ----------------------------------------------
# Without BUZZ_RELAY_PRIVATE_KEY the relay logs that it is using a hardcoded dev
# keypair. This is the relay's own nostr secret key (32-byte hex).
BUZZ_RELAY_PRIVATE_KEY=__RELAY_PRIVKEY__

# When false, REST API requests bypass token auth and the relay warns at startup.
BUZZ_REQUIRE_AUTH_TOKEN=true

# ---- logging ---------------------------------------------------------------
# Drop tower_http to info once you are done verifying; debug is very chatty.
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=warn
